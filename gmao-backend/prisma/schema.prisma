generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CHEF_MAINTENANCE
  CHEF_TECHNICIEN
  TECHNICIEN
  MAGASINIER
}

enum TypePanne {
  TECHNIQUE
  QUALITE
}


enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESH
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
}

enum StatutDI {
  NOUVELLE
  EN_COURS
  RESOLUE
  CLOTUREE
}

enum StatutOT {
  CREE
  ASSIGNE
  EN_COURS
  REPORTE        
  RAPPORTE       
  EN_ATTENTE_VALIDATION 
  NON_VALIDE    
  ANNULE       
  FERME          
}

enum Priorite {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}

enum TypeMaintenance {
  CORRECTIVE
  PREVENTIVE
}

enum FrequenceMaintenance {
  HEBDOMADAIRE
  MENSUELLE
  TRIMESTRIELLE
  SEMESTRIELLE
  ANNUELLE
}

model User {
  id                 Int       @id @default(autoincrement())
  nom                String    @db.VarChar(100)
  prenom             String    @db.VarChar(100)
  email              String    @unique @db.VarChar(255)
  motDePasse         String    @db.VarChar(255)
  role               Role      @default(TECHNICIEN)
  actif              Boolean   @default(true)
  tentativesEchouees Int       @default(0)
  verrouilleJusqua   DateTime? @db.Timestamp(6)
  dernierLogin       DateTime? @db.Timestamp(6)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens RefreshToken[]
  loginAudits   LoginAudit[]

  demandesIntervention        DemandeIntervention[] @relation("DIDeclarePar")
  demandesInterventionAssigne DemandeIntervention[] @relation("DIAssigneA")
  ordresTravailTechnicien     OrdreTravail[]        @relation("OTTechnicien")
  ordresTravailValides        OrdreTravail[]        @relation("OTValidePar")
  rapportsIntervention        RapportIntervention[] @relation("RapportRedacteur")
  plansMaintenance            PlanMaintenance[]     @relation("PlanCreePar")
  lignes                      Ligne[]               @relation("TechnicienLignes")
  mouvementsStock             MouvementStock[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id            Int      @id @default(autoincrement())
  tokenHash     String   @db.VarChar(255)
  userId        Int
  tokenFamily   String   @db.VarChar(36)
  expiresAt     DateTime @db.Timestamp(6)
  revoque       Boolean  @default(false)
  revoqueRaison String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([tokenFamily])
  @@map("refresh_tokens")
}

model LoginAudit {
  id        Int         @id @default(autoincrement())
  userId    Int?
  email     String      @db.VarChar(255)
  action    AuditAction
  ipAddress String      @db.VarChar(45)
  userAgent String?     @db.VarChar(500)
  details   String?     @db.Text
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
  @@map("login_audits")
}



model Atelier {
  id          Int      @id @default(autoincrement())
  nom         String   @db.VarChar(100)
  description String?  @db.Text
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lignes               Ligne[]
  demandesIntervention DemandeIntervention[]
  ordresTravail        OrdreTravail[]
  plansMaintenance     PlanMaintenance[]

  @@map("ateliers")
}

model Ligne {
  id          Int      @id @default(autoincrement())
  nom         String   @db.VarChar(100)
  description String?  @db.Text
  atelierId   Int
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  atelier              Atelier               @relation(fields: [atelierId], references: [id], onDelete: Cascade)
  postes               Poste[]
  demandesIntervention DemandeIntervention[]
  ordresTravail        OrdreTravail[]
  plansMaintenance     PlanMaintenance[]
  techniciens          User[]                @relation("TechnicienLignes")
  pannes               Panne[]

  @@index([atelierId])
  @@map("lignes")
}

model Poste {
  id          Int      @id @default(autoincrement())
  nom         String   @db.VarChar(100)
  description String?  @db.Text
  ligneId     Int
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ligne                Ligne                 @relation(fields: [ligneId], references: [id], onDelete: Cascade)
  demandesIntervention DemandeIntervention[]
  ordresTravail        OrdreTravail[]
  plansMaintenance     PlanMaintenance[]
  pannes               Panne[]

  @@index([ligneId])
  @@map("postes")
}

model Panne {
  id          Int       @id @default(autoincrement())
  nom         String    @db.VarChar(200)
  description String?   @db.Text
  ligneId     Int?
  posteId     Int?
  type        TypePanne @default(TECHNIQUE)
  createdAt   DateTime  @default(now())

  ligne    Ligne?                @relation(fields: [ligneId], references: [id], onDelete: Cascade)
  poste    Poste?                @relation(fields: [posteId], references: [id], onDelete: Cascade)
  demandes DemandeIntervention[]

  @@index([ligneId])
  @@index([posteId])
  @@map("pannes")
}


model FamilleProduit {
  id        Int      @id @default(autoincrement())
  nom       String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produits Produit[]

  @@map("familles_produits")
}

model Produit {
  id               Int      @id @default(autoincrement())
  nom              String   @db.VarChar(200)
  familleProduitId Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  familleProduit FamilleProduit        @relation(fields: [familleProduitId], references: [id])
  demandes       DemandeIntervention[]

  @@index([familleProduitId])
  @@map("produits")
}

model PieceRechange {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(50)
  nom           String   @db.VarChar(200)
  description   String?  @db.Text
  quantiteStock Int      @default(0)
  seuilAlerte   Int      @default(5)
  prixUnitaire  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mouvements   MouvementStock[]
  utilisations PieceUtilisee[]

  @@map("pieces_rechange")
}

enum TypeMouvement {
  ENTREE
  SORTIE
}

model MouvementStock {
  id          Int           @id @default(autoincrement())
  pieceId     Int
  type        TypeMouvement
  quantite    Int
  referenceOT String?       @db.VarChar(50)
  userId      Int
  createdAt   DateTime      @default(now())

  piece       PieceRechange @relation(fields: [pieceId], references: [id])
  utilisateur User          @relation(fields: [userId], references: [id])

  @@index([pieceId])
  @@index([userId])
  @@map("mouvements_stock")
}

model PieceUtilisee {
  id                    Int      @id @default(autoincrement())
  rapportInterventionId Int
  pieceId               Int
  quantite              Int
  createdAt             DateTime @default(now())

  rapport RapportIntervention @relation(fields: [rapportInterventionId], references: [id], onDelete: Cascade)
  piece   PieceRechange       @relation(fields: [pieceId], references: [id])

  @@index([rapportInterventionId])
  @@index([pieceId])
  @@map("pieces_utilisees")
}



model DemandeIntervention {
  id               Int      @id @default(autoincrement())
  numeroDI         String   @unique @db.VarChar(20)
  atelierId        Int
  ligneId          Int
  posteId          Int
  produitId        Int?
  panneId          Int?
  documentUtileUrl String?  @db.VarChar(500)
  priorite         Priorite @default(MOYENNE)
  statut           StatutDI @default(NOUVELLE)
  declareParId     Int
  technicienId     Int?
  dateDeclaration  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  atelier       Atelier        @relation(fields: [atelierId], references: [id])
  ligne         Ligne          @relation(fields: [ligneId], references: [id])
  poste         Poste          @relation(fields: [posteId], references: [id])
  declarePar    User           @relation("DIDeclarePar", fields: [declareParId], references: [id])
  technicien    User?          @relation("DIAssigneA", fields: [technicienId], references: [id])
  produit       Produit?       @relation(fields: [produitId], references: [id])
  panne         Panne?         @relation(fields: [panneId], references: [id])
  ordresTravail OrdreTravail[]

  @@index([atelierId])
  @@index([ligneId])
  @@index([posteId])
  @@index([produitId])
  @@index([declareParId])
  @@index([technicienId])
  @@index([panneId])
  @@index([statut])
  @@index([priorite])
  @@index([dateDeclaration])
  @@map("demandes_intervention")
}

model OrdreTravail {
  id                    Int             @id @default(autoincrement())
  numeroOT              String          @unique @db.VarChar(20)
  demandeInterventionId Int?
  technicienId          Int?
  atelierId             Int
  ligneId               Int
  posteId               Int
  datePrevue            DateTime?       @db.Date
  priorite              Priorite        @default(MOYENNE)
  statut                StatutOT        @default(CREE)
  typeMaintenance       TypeMaintenance @default(CORRECTIVE)
  description          String?         @db.Text
  planMaintenanceId    Int?
  valideParId          Int?
  dateValidation       DateTime?
  dateDebut            DateTime?
  dateFin              DateTime?
  raisonReport         String?         @db.Text
  raisonAnnulation     String?         @db.Text
  raisonNonValidation  String?         @db.Text
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  demandeIntervention DemandeIntervention? @relation(fields: [demandeInterventionId], references: [id])
  technicien          User?                @relation("OTTechnicien", fields: [technicienId], references: [id])
  atelier             Atelier              @relation(fields: [atelierId], references: [id])
  ligne               Ligne                @relation(fields: [ligneId], references: [id])
  poste               Poste                @relation(fields: [posteId], references: [id])
  planMaintenance     PlanMaintenance?     @relation(fields: [planMaintenanceId], references: [id])
  validePar           User?                @relation("OTValidePar", fields: [valideParId], references: [id])
  rapportIntervention RapportIntervention?

  @@index([demandeInterventionId])
  @@index([technicienId])
  @@index([atelierId])
  @@index([ligneId])
  @@index([posteId])
  @@index([statut])
  @@index([typeMaintenance])
  @@index([planMaintenanceId])
  @@index([datePrevue])
  @@map("ordres_travail")
}

model RapportIntervention {
  id                Int      @id @default(autoincrement())
  ordreTravailId    Int      @unique
  diagnostic        String   @db.Text
  causePanne        String?  @db.Text
  actionsRealisees  String   @db.Text
  tempsIntervention Int /// durée en minutes
  tempsArret        Int? /// durée d'arrêt machine en minutes
  commentaires      String?  @db.Text
  redacteurId       Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ordreTravail    OrdreTravail    @relation(fields: [ordreTravailId], references: [id])
  redacteur       User            @relation("RapportRedacteur", fields: [redacteurId], references: [id])
  piecesUtilisees PieceUtilisee[]

  @@index([redacteurId])
  @@map("rapports_intervention")
}



model PlanMaintenance {
  id                 Int                  @id @default(autoincrement())
  intitule           String               @db.VarChar(200)
  description        String?              @db.Text
  atelierId          Int
  ligneId            Int
  posteId            Int
  frequence          FrequenceMaintenance
  actif              Boolean              @default(true)
  dernierExecution   DateTime?
  prochaineExecution DateTime?            @db.Date
  creeParId          Int
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  atelier       Atelier        @relation(fields: [atelierId], references: [id])
  ligne         Ligne          @relation(fields: [ligneId], references: [id])
  poste         Poste          @relation(fields: [posteId], references: [id])
  creePar       User           @relation("PlanCreePar", fields: [creeParId], references: [id])
  ordresTravail OrdreTravail[]

  @@index([atelierId])
  @@index([ligneId])
  @@index([posteId])
  @@index([creeParId])
  @@index([prochaineExecution])
  @@map("plans_maintenance")
}

enum OutboxStatus {
  PENDING   
  QUEUED    
  PROCESSED 
  FAILED   
}

model OutboxEvent {
  id        Int          @id @default(autoincrement())
  type      String       @db.VarChar(100)
  payload   Json         /// Stores the data needed (DI ID, technician email)
  status    OutboxStatus @default(PENDING)
  error     String?      @db.Text 
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status]) /// Crucial: we will frequently query for "PENDING"
  @@map("outbox_events")
}
