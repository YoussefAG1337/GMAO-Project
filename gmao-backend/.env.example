# Database
DATABASE_URL="mysql://root:root@localhost:3306/gmao"

# JWT Secrets — generate with `openssl rand -hex 64`, never reuse across environments
ACCESS_TOKEN_SECRET="changeme"
REFRESH_TOKEN_SECRET="changeme"

# Token Expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Brute Force Protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Server
PORT=5000
FRONTEND_URL="http://localhost:3000"

# Environment
NODE_ENV="development"

# Logging (pino) — omit to default to "debug" in development, "info" in production
LOG_LEVEL="debug"

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GMAO Support <noreply@example.com>"

# Redis Configuration
# Utilisé par BullMQ (file d'emails) ET par la fenêtre de grâce de rotation des
# refresh tokens (auth.service.ts). Si Redis est indisponible, l'auth continue
# de fonctionner mais sans protection contre les courses de refresh multi-onglets.
REDIS_HOST=localhost
REDIS_PORT=6379

# Observability (OpenTelemetry) — see observability.md
# Omit OTEL_EXPORTER_OTLP_ENDPOINT to disable telemetry export entirely.
OTEL_SERVICE_NAME="gmao-backend"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
